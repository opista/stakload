# Generic multi-stage production Dockerfile for all NestJS services.
#
# Usage:
#   docker build --build-arg APP_NAME=api-webhook -f docker/Dockerfile.nest .
#
# Adding a new service: no changes needed here — just update
# docker-compose.yml with the correct APP_NAME build arg.

ARG APP_NAME

# ---- builder -------------------------------------------------------
FROM node:24-bookworm-slim AS builder

ARG APP_NAME

WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/${APP_NAME} ./apps/${APP_NAME}

# --ignore-scripts skips lifecycle scripts for a faster, safer install.
RUN pnpm install --frozen-lockfile --ignore-scripts

# Build each shared package, then the app.
# We iterate explicitly rather than using `pnpm -r` because pnpm's
# workspace member discovery is unreliable when the workspace is only
# partially present (a single app directory, not all apps). A direct
# `pnpm --dir` call works regardless of workspace state.
# Shared packages have no cross-dependencies so filesystem order is fine.
RUN for pkg in packages/*/; do pnpm --dir "${pkg%/}" run --if-present build; done
RUN pnpm --dir apps/${APP_NAME} build

# Create a production-only deployment for the selected app. A workspace-root
# prune drops app-level pnpm links, so deploy is used to preserve the runtime
# dependency graph without carrying dev tooling into the runner image.
RUN pnpm --filter "@stakload/${APP_NAME}" --prod deploy --legacy /workspace/deploy

# ---- runner --------------------------------------------------------
FROM node:24-bookworm-slim AS runner

WORKDIR /app

# Copy pre-built production artefacts from builder — no install step needed.
COPY --from=builder --chown=node:node /workspace/deploy ./

# Drop to the non-privileged node user (uid 1000) that ships with the
# base image. Limits blast radius if the process is ever compromised.
USER node

CMD ["node", "dist/src/main.js"]
